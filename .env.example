# Copy this file to ".env" and fill in your own Razorpay TEST MODE keys.
# See README.md -> "Getting your free Razorpay test API key" for how to get these.
# Never commit your real .env file or share your Key Secret with anyone.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Optional: ipgeolocation.io API key, used by the geo/IP risk module for
# accurate country lookups. Get a free key at https://ipgeolocation.io/
# If left blank, the app automatically falls back to ip-api.com (free,
# no key, lower rate limit) -- so the app still works without this.
GEO_API_KEY=your_ipgeolocation.io_key_here
